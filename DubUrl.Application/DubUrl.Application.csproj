<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DubUrl.Core\DubUrl.Core.csproj" />
    <PackageReference Include="DubUrl.Schema.Documents" Version="[$(SchemaPackageVersion)]" />
    <PackageReference Include="DubUrl.Schema" Version="[$(SchemaPackageVersion)]" />
    <!-- Run the catalog generator on the build host, independently of the app's publish runtime. -->
    <ProjectReference Include="../connectors/Catalog/ConnectorCatalog.Build.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSingleFile;PublishTrimmed;PublishAot" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>DubUrl.Application</PackageId>
    <RepositoryUrl>https://github.com/Seddryck/DubUrl</RepositoryUrl>
    <PackageTags>connection-string;database;sql;schema;application-api</PackageTags>
    <Description>Transport-neutral application services for validating, rendering, and deploying DubUrl schema documents, and managing curated connectors.</Description>
  </PropertyGroup>

  <Import Project="../connectors/ConnectorCatalog.targets" />
  <Target Name="EmbedConnectorCatalog" BeforeTargets="AssignTargetPaths" DependsOnTargets="GenerateConnectorCatalog">
    <ItemGroup>
      <EmbeddedResource Include="$(ConnectorCatalogOutput)" LogicalName="DubUrl.ConnectorCatalog" />
    </ItemGroup>
  </Target>
</Project>
