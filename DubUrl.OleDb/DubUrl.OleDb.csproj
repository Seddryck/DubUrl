<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="10.0.12" />
    <!-- OleDb 10 error RCWs can crash the .NET 8 finalizer; dotnet/runtime#125221. -->
    <PackageReference Update="System.Data.OleDb" Version="9.0.21" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DubUrl.Core\DubUrl.Core.csproj" />
		<PackageReference Include="DubUrl.Provider.Access" Version="$(DubUrlProviderVersion)" />
		<PackageReference Include="DubUrl.Provider.Excel" Version="$(DubUrlProviderVersion)" />
		<PackageReference Include="DubUrl.Provider.MySql" Version="$(DubUrlProviderVersion)" />
		<PackageReference Include="DubUrl.Provider.Oracle" Version="$(DubUrlProviderVersion)" />
		<PackageReference Include="DubUrl.Provider.SqlServer" Version="$(DubUrlProviderVersion)" />
	</ItemGroup>

	<Target Name="BoundDubUrlDependencyVersions" AfterTargets="_GetProjectReferenceVersions">
		<ItemGroup>
			<_ProjectReferencesWithVersions Update="%(_ProjectReferencesWithVersions.Identity)">
				<ProjectVersion>[$(Version),1.0.0)</ProjectVersion>
			</_ProjectReferencesWithVersions>
		</ItemGroup>
	</Target>

	<ItemGroup>
	  <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<PackageId>DubUrl.OleDb</PackageId>
		<RepositoryUrl>https://github.com/Seddryck/DubUrl</RepositoryUrl>
		<PackageTags>connection-string;database;sql;oledb</PackageTags>
		<Description>DubUrl provides a standardized URL-style mechanism for providing database connection information and opening a DbConnection in the .NET ecosystem</Description>
	</PropertyGroup>
	
</Project>
