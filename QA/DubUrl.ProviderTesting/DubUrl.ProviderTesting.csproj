<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>DubUrl.ProviderTesting</PackageId>
    <Description>Reusable live provider QA contracts for DubUrl provider modules.</Description>
  </PropertyGroup>
  <ItemGroup>
