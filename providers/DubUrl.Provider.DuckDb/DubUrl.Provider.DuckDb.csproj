<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><Description>DuckDB dialect, mapping, and rewriting for DubUrl.</Description></PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\DubUrl.Core\Mapping\Database\DuckdbDatabase.cs" Link="Mapping\Database\DuckdbDatabase.cs" />
    <Compile Include="..\..\DubUrl.Core\Mapping\Implementation\DuckdbMapper.cs" Link="Mapping\Implementation\DuckdbMapper.cs" />
    <Compile Include="..\..\DubUrl.Core\Rewriting\Implementation\DuckdbRewriter.cs" Link="Rewriting\Implementation\DuckdbRewriter.cs" />
    <Compile Include="..\..\DubUrl.Core\Querying\Dialects\DuckdbDialect.cs" Link="Querying\Dialects\DuckdbDialect.cs" />
    <Compile Include="..\..\DubUrl.Core\Querying\Dialects\Formatters\DuckDBQuotedIdentifierFormatter.cs" Link="Querying\Dialects\Formatters\DuckDBQuotedIdentifierFormatter.cs" />
    <Compile Include="..\..\DubUrl.Core\Querying\Dialects\Functions\DuckDbFunctionMapper.cs" Link="Querying\Dialects\Functions\DuckDbFunctionMapper.cs" />
    <Compile Include="..\..\DubUrl.Core\Querying\Dialects\Renderers\DuckDBRenderer.cs" Link="Querying\Dialects\Renderers\DuckDBRenderer.cs" />
    <Compile Include="..\..\DubUrl.Core\Querying\TypeMapping\DuckDbTypeMapper.cs" Link="Querying\TypeMapping\DuckDbTypeMapper.cs" />
    <EmbeddedResource Include="..\..\DubUrl.Core\Querying\Dialects\Formatters\ReservedKeywords\DuckDB\*.txt"
                      Link="Querying\Dialects\Formatters\ReservedKeywords\DuckDB\%(Filename)%(Extension)"
                      LogicalName="DubUrl.Querying.Dialects.Formatters.ReservedKeywords.DuckDB.%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="..\Provider.Build.props" />
</Project>
