<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DubUrl.Core</AssemblyName>
    <RootNamespace>DubUrl.Core</RootNamespace>
    <PackageId>DubUrl.Core</PackageId>
    <Description>Provider-neutral contracts and deterministic provider catalog for DubUrl.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Didot.Core" Version="0.34.0" />
    <InternalsVisibleTo Include="DubUrl.Core.Testing" />
  </ItemGroup>

  <!-- Share precisely Core's runtime dependencies, rather than every assembly in the host. -->
  <Target Name="GenerateSharedDependencies" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <WriteLinesToFile File="$(IntermediateOutputPath)CoreDependencyPaths.txt"
                      Lines="@(RuntimeCopyLocalItems->'%(DestinationSubPath)');@(ResourceCopyLocalItems->'%(DestinationSubPath)');@(RuntimeTargetsCopyLocalItems->'%(DestinationSubPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)CoreDependencyPaths.txt" LogicalName="DubUrl.Core.SharedDependencies" />
    </ItemGroup>
  </Target>

</Project>
