<Project>
  <PropertyGroup>
    <AssemblyName>$(ConnectorAssemblyName)</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <PackageId>$(AssemblyName)</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ConnectorId</_Parameter1>
      <_Parameter2>$(ConnectorId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DatabaseName</_Parameter1>
      <_Parameter2>$(ConnectorDatabaseName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Aliases</_Parameter1>
      <_Parameter2>$(ConnectorAliases)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProviderInvariant</_Parameter1>
      <_Parameter2>$(ConnectorProviderInvariant)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FactoryType</_Parameter1>
      <_Parameter2>$(ConnectorFactoryType)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DialectType</_Parameter1>
      <_Parameter2>$(ConnectorDialectType)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MapperType</_Parameter1>
      <_Parameter2>$(ConnectorMapperType)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ParametrizerType</_Parameter1>
      <_Parameter2>$(ConnectorParametrizerType)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="GenerateProviderBindingModule" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' != ''">
    <PropertyGroup>
      <_ProviderBindingModuleFile>$(IntermediateOutputPath)ProviderModule.g.cs</_ProviderBindingModuleFile>
    </PropertyGroup>
    <ItemGroup>
      <_ProviderBindingModuleLine Include="// &lt;auto-generated /&gt;" />
      <_ProviderBindingModuleLine Include="namespace $(AssemblyName)%3B" />
      <_ProviderBindingModuleLine Include="public sealed class ProviderModule : global::DubUrl.Mapping.AssemblyMetadataProviderModule" />
      <_ProviderBindingModuleLine Include="{" />
      <_ProviderBindingModuleLine Include="    public ProviderModule() : base(typeof(ProviderModule).Assembly) { }" />
      <_ProviderBindingModuleLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_ProviderBindingModuleFile)" Lines="@(_ProviderBindingModuleLine)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(_ProviderBindingModuleFile)" AutoGen="true" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
