<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ConnectorId Condition="'$(ConnectorId)' == ''">postgresql-npgsql</ConnectorId>
    <ConnectorAssemblyName Condition="'$(ConnectorAssemblyName)' == ''">DubUrl.Provider.PostgreSql.Npgsql</ConnectorAssemblyName>
    <ConnectorDatabaseName Condition="'$(ConnectorDatabaseName)' == ''">PostgreSQL</ConnectorDatabaseName>
    <ConnectorAliases Condition="'$(ConnectorAliases)' == ''">pg|pgx|pgsql|postgres|postgresql</ConnectorAliases>
    <ConnectorProviderInvariant Condition="'$(ConnectorProviderInvariant)' == ''">Npgsql</ConnectorProviderInvariant>
    <ConnectorFactoryType Condition="'$(ConnectorFactoryType)' == ''">Npgsql.NpgsqlFactory, Npgsql</ConnectorFactoryType>
    <ConnectorDialectType Condition="'$(ConnectorDialectType)' == ''">DubUrl.Provider.PostgreSql.Sql.PgsqlDialect, DubUrl.Provider.PostgreSql</ConnectorDialectType>
    <ConnectorMapperType Condition="'$(ConnectorMapperType)' == ''">DubUrl.Provider.PostgreSql.Mapping.PostgresqlMapper, DubUrl.Provider.PostgreSql</ConnectorMapperType>
    <ConnectorParametrizerType Condition="'$(ConnectorParametrizerType)' == ''">DubUrl.Querying.Parametrizing.PositionalParametrizer, DubUrl.Core</ConnectorParametrizerType>
    <Description>PostgreSQL provider binding for DubUrl backed by Npgsql.</Description>
    <PackageTags>connection-string;database;postgresql;npgsql;ado-net;adonet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <ProjectReference Include="..\..\..\DubUrl.Core\DubUrl.Core.csproj" />
    <ProjectReference Include="..\DubUrl.Provider.PostgreSql\DubUrl.Provider.PostgreSql.csproj" />
  </ItemGroup>

  <Target Name="BoundDubUrlDependencyVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions
        Update="%(_ProjectReferencesWithVersions.Identity)">
        <ProjectVersion>[$(Version),1.0.0)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

  <Import Project="..\..\Build\ProviderBinding.props" />
</Project>
