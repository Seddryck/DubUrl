{{#each model.Tables}}
CREATE TABLE {{identity Name}} (
{{#each Columns}}
    {{identity Name}} {{columntype this ~}}
    {{#if Length}}({{Length}}){{/if~}}
    {{#if Precision}}({{Precision}}, {{Scale}}){{/if~}}
    {{#if Nullable}} NULL{{/if~}}
    {{#if NotNullable}} NOT NULL{{/if~}}
    {{#if PrimaryKey}} PRIMARY KEY{{/if~}}
    {{#if Unique}} UNIQUE{{/if~}}
    {{#if HasDefaultValue}} DEFAULT {{value DefaultValue}}{{/if~}}
    {{#each Checks}} CHECK {{#if Left.Function}}{{function Left.Function}}({{identity Left.Name}}){{else}}{{identity Left.Name}}{{/if}} {{Operator}} {{Right.Value}}
    {{~ /each ~}}
    {{#each MembershipChecks}} CHECK {{membership this}}
    {{~ /each ~}}
    {{#each RegexChecks}} CHECK {{regex this}}
    {{~ /each ~}}
    {{#unless @last}},{{/unless}}
{{/each}}
{{#if PrimaryKey}}
    , CONSTRAINT {{identity ([String.Append] 'PK_' Name)}} PRIMARY KEY (
{{~ #each PrimaryKey.Columns}}
{{identity Name}}{{#unless @last}}, {{/unless~}}
{{/each~}}
)
{{/if~}}
{{#if RenderForeignKeysInline}}
{{#each ForeignKeys}}
    , CONSTRAINT {{identity Name}} FOREIGN KEY (
{{~ #each SourceColumns}}{{identity this}}{{#unless @last}}, {{/unless}}{{/each~}}
) REFERENCES {{identity TargetTableName}} (
{{~ #each TargetColumns}}{{identity this}}{{#unless @last}}, {{/unless}}{{/each~}}
)
{{/each}}
{{/if~}}
);
{{/each}}
