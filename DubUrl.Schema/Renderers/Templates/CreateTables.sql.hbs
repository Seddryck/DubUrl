{{#each model.Tables}}
{{identityprerequisites this}}CREATE TABLE {{objectname Identity}} (
{{#each Columns}}
    {{identity Name}} {{columnspec this ~}}
    {{#if Nullable}} NULL{{/if~}}
    {{#if NotNullable}} NOT NULL{{/if~}}
    {{#if PrimaryKey}} {{#if PrimaryKey.Name}}CONSTRAINT {{identity PrimaryKey.Name}} {{/if}}PRIMARY KEY{{/if~}}
    {{#if Unique}} UNIQUE{{/if~}}
    {{#if HasDefaultValue}} DEFAULT {{value DefaultValue}}{{/if~}}
    {{#each Checks}} CHECK ({{check this}})
    {{~ /each ~}}
    {{#each MembershipChecks}} CHECK ({{membership this}})
    {{~ /each ~}}
    {{#each RegexChecks}} CHECK ({{regex this}})
    {{~ /each ~}}
    {{#if Description}}{{columncomment Description}}{{/if~}}
    {{#unless @last}},{{/unless}}
{{/each}}
{{#if PrimaryKey}}
    , CONSTRAINT {{#if PrimaryKey.Name}}{{identity PrimaryKey.Name}}{{else}}{{identity ([String.Append] 'PK_' Name)}}{{/if}} PRIMARY KEY (
{{~ #each PrimaryKey.Columns}}
{{identity Name}}{{#unless @last}}, {{/unless~}}
{{/each~}}
)
{{/if~}}
{{#each UniqueConstraints}}
    , {{#if Name}}CONSTRAINT {{identity Name}} {{/if}}UNIQUE ({{#each Columns}}{{identity Name}}{{#unless @last}}, {{/unless}}{{/each}})
{{/each~}}
{{#each Checks}}
    , {{#if Name}}CONSTRAINT {{identity Name}} {{/if}}CHECK ({{check this}})
{{/each~}}
{{#each MembershipChecks}}
    , {{#if Name}}CONSTRAINT {{identity Name}} {{/if}}CHECK ({{membership this}})
{{/each~}}
{{#each RegexChecks}}
    , {{#if Name}}CONSTRAINT {{identity Name}} {{/if}}CHECK ({{regex this}})
{{/each~}}
{{#if RenderForeignKeysInline}}
{{#each ForeignKeys}}
    , CONSTRAINT {{identity Name}} FOREIGN KEY (
{{~ #each SourceColumns}}{{identity this}}{{#unless @last}}, {{/unless}}{{/each~}}
) REFERENCES {{objectname TargetTable}} (
{{~ #each TargetColumns}}{{identity this}}{{#unless @last}}, {{/unless}}{{/each~}}
)
{{/each}}
{{/if~}}
);
{{/each}}
