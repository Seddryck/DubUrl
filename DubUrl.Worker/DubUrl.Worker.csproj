<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DubUrl.Worker</AssemblyName>
    <RootNamespace>DubUrl.Worker</RootNamespace>
    <ApplicationIcon>..\misc\icon\duburl.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-musl-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <NoWarn>$(NoWarn);NU5118</NoWarn>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>duburl-worker</ToolCommandName>
    <PackageId>DubUrl.Worker</PackageId>
    <PackageReadmeFile>worker-readme.md</PackageReadmeFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RepositoryUrl>https://github.com/Seddryck/DubUrl</RepositoryUrl>
    <PackageTags>database;schema;json-rpc;worker;dotnet-tool</PackageTags>
    <Description>Persistent JSON-RPC worker infrastructure for DubUrl application services.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DubUrl.Application\DubUrl.Application.csproj" />
    <ProjectReference Include="..\DubUrl.Core\DubUrl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="worker-readme.md" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="../DubUrl.Core/buildTransitive/DubUrl.targets" />
  <ItemGroup>
    <ProjectReference Include="../Providers/Access/DubUrl.Provider.Access/DubUrl.Provider.Access.csproj" />
    <ProjectReference Include="../Providers/Db2/DubUrl.Provider.Db2/DubUrl.Provider.Db2.csproj" />
    <ProjectReference Include="../Providers/Drill/DubUrl.Provider.Drill/DubUrl.Provider.Drill.csproj" />
    <ProjectReference Include="../Providers/DuckDb/DubUrl.Provider.DuckDb/DubUrl.Provider.DuckDb.csproj" />
    <ProjectReference Include="../Providers/Excel/DubUrl.Provider.Excel/DubUrl.Provider.Excel.csproj" />
    <ProjectReference Include="../Providers/FirebirdSql/DubUrl.Provider.FirebirdSql/DubUrl.Provider.FirebirdSql.csproj" />
    <ProjectReference Include="../Providers/MySql/DubUrl.Provider.MySql/DubUrl.Provider.MySql.csproj" />
    <ProjectReference Include="../Providers/Odbc/DubUrl.Provider.Odbc/DubUrl.Provider.Odbc.csproj" />
    <ProjectReference Include="../Providers/Oracle/DubUrl.Provider.Oracle/DubUrl.Provider.Oracle.csproj" />
    <ProjectReference Include="../Providers/PostgreSql/DubUrl.Provider.PostgreSql/DubUrl.Provider.PostgreSql.csproj" />
    <ProjectReference Include="../Providers/Snowflake/DubUrl.Provider.Snowflake/DubUrl.Provider.Snowflake.csproj" />
    <ProjectReference Include="../Providers/Sqlite/DubUrl.Provider.Sqlite/DubUrl.Provider.Sqlite.csproj" />
    <ProjectReference Include="../Providers/SqlServer/DubUrl.Provider.SqlServer/DubUrl.Provider.SqlServer.csproj" />
    <ProjectReference Include="../Providers/Teradata/DubUrl.Provider.Teradata/DubUrl.Provider.Teradata.csproj" />
    <ProjectReference Include="../Providers/Text/DubUrl.Provider.Text/DubUrl.Provider.Text.csproj" />
    <ProjectReference Include="../Providers/Trino/DubUrl.Provider.Trino/DubUrl.Provider.Trino.csproj" />
  </ItemGroup>
</Project>
