<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DubUrl.Connector.PostgreSql.Npgsql</PackageId>
    <AssemblyName>DubUrl.Connector.PostgreSql.Npgsql</AssemblyName>
    <RootNamespace>DubUrl.Connector.PostgreSql.Npgsql</RootNamespace>
    <Description>PostgreSQL connector module for DubUrl backed by Npgsql.</Description>
    <PackageTags>connection-string;database;postgresql;npgsql;ado-net;adonet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <ProjectReference Include="..\..\DubUrl.Core\DubUrl.Core.csproj" />
    <ProjectReference Include="..\..\Providers\PostgreSql\DubUrl.Provider.PostgreSql\DubUrl.Provider.PostgreSql.csproj" />
  </ItemGroup>

  <Target Name="BoundDubUrlDependencyVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions
        Update="%(_ProjectReferencesWithVersions.Identity)">
        <ProjectVersion>[$(Version),1.0.0)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
