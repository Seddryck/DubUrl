<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ConnectorId Condition="'$(ConnectorId)' == ''">duckdb-native</ConnectorId>
    <ConnectorAssemblyName Condition="'$(ConnectorAssemblyName)' == ''">DubUrl.Connector.DuckDb.Native</ConnectorAssemblyName>
    <ConnectorFamily Condition="'$(ConnectorFamily)' == ''">DuckDb</ConnectorFamily>
    <ConnectorTechnology Condition="'$(ConnectorTechnology)' == ''">DuckDb</ConnectorTechnology>
    <ConnectorDatabaseName Condition="'$(ConnectorDatabaseName)' == ''">DuckDB</ConnectorDatabaseName>
    <ConnectorAliases Condition="'$(ConnectorAliases)' == ''">duck|duckdb</ConnectorAliases>
    <ConnectorProviderInvariant Condition="'$(ConnectorProviderInvariant)' == ''">DuckDB.NET.Data</ConnectorProviderInvariant>
    <ConnectorFactoryType Condition="'$(ConnectorFactoryType)' == ''">DuckDB.NET.Data.DuckDBClientFactory, DuckDB.NET.Data</ConnectorFactoryType>
    <ConnectorDialectType Condition="'$(ConnectorDialectType)' == ''">DubUrl.Querying.Dialects.DuckDbDialect, DubUrl.Provider.DuckDb</ConnectorDialectType>
    <ConnectorMapperType Condition="'$(ConnectorMapperType)' == ''">DubUrl.Mapping.Implementation.DuckdbMapper, DubUrl.Provider.DuckDb</ConnectorMapperType>
    <ConnectorParametrizerType Condition="'$(ConnectorParametrizerType)' == ''">DubUrl.Querying.Parametrizing.PositionalParametrizer, DubUrl.Core</ConnectorParametrizerType>
    <AssemblyName>$(ConnectorAssemblyName)</AssemblyName>
    <RootNamespace>DubUrl.Connector</RootNamespace>
    <PackageId>$(ConnectorAssemblyName)</PackageId>
    <Description>Generated connector module for $(ConnectorDatabaseName) using $(ConnectorTechnology).</Description>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ConnectorId</_Parameter1>
      <_Parameter2>$(ConnectorId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DatabaseName</_Parameter1>
      <_Parameter2>$(ConnectorDatabaseName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Aliases</_Parameter1>
      <_Parameter2>$(ConnectorAliases)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProviderInvariant</_Parameter1>
      <_Parameter2>$(ConnectorProviderInvariant)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FactoryType</_Parameter1>
      <_Parameter2>$(ConnectorFactoryType)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DialectType</_Parameter1>
      <_Parameter2>$(ConnectorDialectType)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MapperType</_Parameter1>
      <_Parameter2>$(ConnectorMapperType)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ParametrizerType</_Parameter1>
      <_Parameter2>$(ConnectorParametrizerType)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DubUrl.ProviderCore\DubUrl.Core.csproj" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.Access\DubUrl.Provider.Access.csproj" Condition="'$(ConnectorFamily)' == 'Access'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.Db2\DubUrl.Provider.Db2.csproj" Condition="'$(ConnectorFamily)' == 'Db2'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.Drill\DubUrl.Provider.Drill.csproj" Condition="'$(ConnectorFamily)' == 'Drill'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.DuckDb\DubUrl.Provider.DuckDb.csproj" Condition="'$(ConnectorFamily)' == 'DuckDb'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.Excel\DubUrl.Provider.Excel.csproj" Condition="'$(ConnectorFamily)' == 'Excel'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.FirebirdSql\DubUrl.Provider.FirebirdSql.csproj" Condition="'$(ConnectorFamily)' == 'FirebirdSql'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.MySql\DubUrl.Provider.MySql.csproj" Condition="'$(ConnectorFamily)' == 'MySql'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.Oracle\DubUrl.Provider.Oracle.csproj" Condition="'$(ConnectorFamily)' == 'Oracle'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.PostgreSql\DubUrl.Provider.PostgreSql.csproj" Condition="'$(ConnectorFamily)' == 'PostgreSql'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.Snowflake\DubUrl.Provider.Snowflake.csproj" Condition="'$(ConnectorFamily)' == 'Snowflake'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.Sqlite\DubUrl.Provider.Sqlite.csproj" Condition="'$(ConnectorFamily)' == 'Sqlite'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.SqlServer\DubUrl.Provider.SqlServer.csproj" Condition="'$(ConnectorFamily)' == 'SqlServer'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.Teradata\DubUrl.Provider.Teradata.csproj" Condition="'$(ConnectorFamily)' == 'Teradata'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.Text\DubUrl.Provider.Text.csproj" Condition="'$(ConnectorFamily)' == 'Text'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.Trino\DubUrl.Provider.Trino.csproj" Condition="'$(ConnectorFamily)' == 'Trino'" />
    <ProjectReference Include="..\..\providers\DubUrl.Provider.Odbc\DubUrl.Provider.Odbc.csproj" Condition="'$(ConnectorTechnology)' == 'Odbc'" />
    <ProjectReference Include="..\..\DubUrl.OleDb\DubUrl.OleDb.csproj" Condition="'$(ConnectorTechnology)' == 'OleDb'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" Condition="'$(ConnectorTechnology)' == 'Npgsql'" />
    <PackageReference Include="Net.IBM.Data.Db2" Version="8.0.0.300" Condition="'$(ConnectorTechnology)' == 'Db2' AND '$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Net.IBM.Data.Db2" Version="9.0.0.200" Condition="'$(ConnectorTechnology)' == 'Db2' AND '$(TargetFramework)' != 'net8.0'" />
    <PackageReference Include="DuckDB.NET.Data" Version="1.5.6" Condition="'$(ConnectorTechnology)' == 'DuckDb'" />
    <PackageReference Include="DuckDB.NET.Bindings.Full" Version="1.5.6" Condition="'$(ConnectorTechnology)' == 'DuckDb'" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.3" Condition="'$(ConnectorTechnology)' == 'Firebird'" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" Condition="'$(ConnectorTechnology)' == 'MySqlConnector'" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" Condition="'$(ConnectorTechnology)' == 'SqlClient'" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" Condition="'$(ConnectorTechnology)' == 'SqlClient' OR '$(ConnectorTechnology)' == 'Oracle'" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" Condition="'$(ConnectorTechnology)' == 'Oracle'" />
    <PackageReference Include="SingleStoreConnector" Version="1.2.0" Condition="'$(ConnectorTechnology)' == 'SingleStore'" />
    <PackageReference Include="Snowflake.Data" Version="6.3.0" Condition="'$(ConnectorTechnology)' == 'Snowflake'" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" Condition="'$(ConnectorTechnology)' == 'Sqlite'" />
    <PackageReference Include="Teradata.Client.Provider" Version="20.0.6" Condition="'$(ConnectorTechnology)' == 'Teradata'" />
    <PackageReference Include="NReco.PrestoAdo" Version="1.1.0" Condition="'$(ConnectorTechnology)' == 'Trino'" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.12" Condition="'$(ConnectorTechnology)' == 'Odbc'" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.12" Condition="'$(ConnectorTechnology)' == 'OleDb'" />
  </ItemGroup>

</Project>
