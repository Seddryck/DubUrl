<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DubUrl.Providers</AssemblyName>
    <RootNamespace>DubUrl.Providers</RootNamespace>
    <PackageId>DubUrl.Providers</PackageId>
    <Description>Curated metadata for database providers listed by DubUrl.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DubUrl.ProviderCore\DubUrl.Core.csproj" />
  </ItemGroup>

  <Target Name="BoundDubUrlDependencyVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="%(_ProjectReferencesWithVersions.Identity)">
        <ProjectVersion>[$(Version),1.0.0)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
